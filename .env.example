# Frontend (root Vite app)
VITE_API_URL=http://localhost:6001/api
VITE_SOCKET_URL=http://localhost:6001
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Backend values are read from backend/.env. Never expose these as VITE_* variables.
PORT=6001
MONGO_URI=mongodb://localhost:27017/breezo_network
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_URL=http://localhost:4001
SENSOR_ENCRYPTION_KEY=replace-with-a-long-random-secret
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
SOLANA_REWARD_MINT=
SOLANA_TREASURY_PUBLIC_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Simulator values are read from simulator/.env.
SIMULATOR_API_URL=http://localhost:6001/api
SIMULATOR_DEVICE_KEYS=
SIMULATOR_JWT=
